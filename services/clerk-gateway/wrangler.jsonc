{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "i10-clerk-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",

  // ⚠ LIVE ON BOTH NAMES SINCE 2026-11-20 (README.md, "Production rollout").
  // Clerk refuses `clerk.i10.tech` as `proxy_url` (sso.md 1.5), so Clerk knows
  // the gateway as the apex path below, and the custom domain keeps the name
  // the publishable key encodes. Deploying this file with a `routes` change
  // moves real sign-in traffic.
  //
  // ⚠ TWO SECRETS, BOTH SET OUT OF BAND, NEVER IN THIS FILE:
  //     wrangler secret put CLERK_SECRET_KEY
  //     wrangler secret put I10_API_SECRET   (the API's IDENTITY_GATEWAY_SECRET)
  // Without the Clerk key, or with one from the other instance, the gateway
  // answers 503 to everything. Without the API secret (or `I10_API_URL`) every
  // managed-account lookup fails, so sign-ins that name an identifier and the
  // self-service account routes answer 503; token refreshes are unaffected.
  "secrets": { "required": ["CLERK_SECRET_KEY", "I10_API_SECRET"] },
  // ⚠ THE APEX PATH IS WHAT CLERK KNOWS US AS. Clerk accepts a `proxy_url` only
  // on the domain's own host (`i10.tech`), so that is the label every forwarded
  // request carries, whichever of the two names it arrived on.
  "routes": [
    { "pattern": "i10.tech/__clerk*", "zone_name": "i10.tech" },
    { "pattern": "clerk.i10.tech", "custom_domain": true },
  ],
  "vars": {
    "INSTANCE": "production",
    "UPSTREAM_ORIGIN": "https://frontend-api.clerk.dev",
    "PROXY_URL": "https://i10.tech/__clerk",
    "ALLOWED_ORIGINS": "https://auth.i10.tech,https://dash.i10.tech",
    "UPSTREAM_TIMEOUT_MS": "10000",
    // Our API, for the managed-account lookup (#337).
    "I10_API_URL": "https://api.i10.tech",
  },
  "observability": { "enabled": true },

  "env": {
    // `bun run dev` here: the DEV instance, reached as https://clerk.i10.localhost
    // through Caddy (dev/Caddyfile). The dev secret comes from Doppler through
    // the process environment, never a file:
    //     doppler run --project i10 --config dev -- bun run dev
    // `secrets.required` is what makes wrangler read it from process.env, and
    // ONLY it - not the rest of the Doppler environment.
    //
    // ⚠ NEVER DEPLOYED. `wrangler deploy --env local` would create a separate
    // Worker; there is no reason to.
    "local": {
      "secrets": { "required": ["CLERK_SECRET_KEY", "I10_API_SECRET"] },
      "vars": {
        "INSTANCE": "development",
        "UPSTREAM_ORIGIN": "https://frontend-api.clerk.dev",
        "PROXY_URL": "https://clerk.i10.localhost",
        "ALLOWED_ORIGINS": "https://auth.i10.localhost,https://dash.i10.localhost",
        "UPSTREAM_TIMEOUT_MS": "10000",
        // ⚠ THE API'S OWN PORT, NOT api.i10.localhost: workerd does not trust
        // Caddy's local CA.
        "I10_API_URL": "http://localhost:3001",
      },
    },
  },

  // `wrangler dev` only (top level: wrangler does not read `dev` per env).
  // Caddy fronts it as https://clerk.i10.localhost (dev/Caddyfile).
  //
  // ⚠ HTTPS LOCALLY TOO, AND NOT FOR SECRECY. wrangler dev rewrites every
  // response header that names the request's host onto the protocol the
  // request arrived with. Over plain http that turned Clerk's
  // `Location: https://clerk.i10.localhost/npm/...` into `http://...`, which
  // the browser then refuses from an https page. Arriving over https makes the
  // rewrite a no-op. The certificate is wrangler's own; Caddy skips verifying
  // it on the loopback hop only.
  "dev": { "port": 3006, "local_protocol": "https" },
}
