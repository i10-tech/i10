# Copy to `.env.development.local` at the repository root, or use Doppler.
# See dev/README.md.

# ── the local containers ─────────────────────────────────────────────────────
# ⚠ `i10_api`, NOT THE `i10` OWNER. Row level security does not apply to a
# table's owner, so connecting as `i10` makes every tenant policy a silent no-op
# — and the boundary that is missing locally is the boundary that ships.
# apps/api/src/db/client.ts refuses to start as an owning role.
# ⚠ AND PORT 5433, because a Homebrew postgres may already hold 5432.
DATABASE_URL=postgres://i10_api:i10_api@127.0.0.1:5433/i10
REDIS_URL=redis://127.0.0.1:6379

# ⚠ MIGRATIONS RUN AS THE OWNER, because a backfill has to be able to cross
# tenants. `bun run dev:migrate` uses this one.
MIGRATION_DATABASE_URL=postgres://i10:i10@127.0.0.1:5433/i10

# ── Clerk: the only credentials that have to be real ─────────────────────────
# From the DEVELOPMENT instance. `sk_test_…` / `pk_test_…`.
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
# Clerk → Webhooks → endpoint → signing secret. Without it a new sign-up never
# gets a tenant and the console says "your workspace is still being created".
CLERK_WEBHOOK_SECRET=

# ⚠ THE `azp` ALLOWLIST. Empty means Clerk checks nothing, and a token minted
# for any application on the instance is accepted here.
CONSOLE_ORIGINS=https://dash.i10.localhost

# ── where the apps find each other ───────────────────────────────────────────
# ⚠ THE CONSOLE'S SERVER COMPONENTS CALL THE API DIRECTLY, over loopback, not
# through Caddy. Going through the proxy would work and would add a TLS
# handshake and a hostname lookup to every server render for no benefit.
API_BASE_URL=http://127.0.0.1:3001
I10_BASE_URL=http://127.0.0.1:3001
NEXT_PUBLIC_APP_URL=https://dash.i10.localhost
NEXT_PUBLIC_AUTH_URL=https://auth.i10.localhost

# ── things that are inert locally ────────────────────────────────────────────
# SES is off, so nothing is actually sent. The configuration set is required by
# the schema; the value is never used while SES_ENABLED is false.
SES_ENABLED=false
SES_CONFIGURATION_SET=i10-local
AWS_REGION=eu-central-1

# ⚠ REQUIRED BEFORE DKIM KEYS, WEBHOOK SECRETS OR DNS CONNECTIONS CAN BE STORED.
# Without it those routes answer 501 rather than writing a secret in the clear.
# Generate with: openssl rand -hex 32
WEBHOOK_SECRET_KEY=

# The local nameserver, on 5353. Delegation records will name these.
MAIL_NAMESERVERS=ns1.i10.localhost,ns2.i10.localhost

# ── optional ─────────────────────────────────────────────────────────────────
# Polar sandbox, if you are working on billing.
# POLAR_ACCESS_TOKEN=
# POLAR_SERVER=sandbox
# POLAR_PRODUCTS={"pro":"…"}
# POLAR_SUCCESS_URL=https://dash.i10.localhost/billing?checkout_id={CHECKOUT_ID}

# DNS provider OAuth apps, if you are working on automatic record publishing.
# Each provider's redirect URI must be registered as
# https://dash.i10.localhost/dns/callback/<slug>
# DNS_OAUTH_APPS={"cloudflare":{"clientId":"…","clientSecret":"…"}}
# DNS_OAUTH_REDIRECT_BASE=https://dash.i10.localhost/dns/callback
