{
  "extends": "@repo/typescript-config/base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "moduleResolution": "Bundler",
    "module": "ESNext",
    "lib": ["es2023", "DOM"],
    "types": ["node"],
    // See packages/node/tsconfig.json — tsup's dts step sets `baseUrl`, which
    // TypeScript 6 errors on. Nothing here uses it.
    "ignoreDeprecations": "6.0"
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
