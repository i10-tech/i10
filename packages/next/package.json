{
  "name": "@i10/next",
  "version": "0.0.0",
  "description": "i10 helpers for Next.js — server client and webhook route handler.",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@i10/node": "workspace:*"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/bun": "^1.4.2",
    "eslint": "^9.39.5",
    "tsup": "^8.5.1",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=20"
  }
}
