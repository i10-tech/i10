{
  // ⚠ base, NOT bun-library. These are Zod schemas and nothing here touches a
  // node API — the package is consumed by the API server, by the browser SDK,
  // and by generated clients. `bun-library.json` sets `types: ["bun"]`, which
  // fails with TS2688 in a package that rightly has no @types/bun, and adding
  // the dependency to silence it would be declaring a runtime this package does
  // not have.
  "extends": "@repo/typescript-config/base.json",
  "compilerOptions": {
    // Local, not inherited — see the note in bun-library.json about paths in
    // an extended config resolving against the file that declares them.
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
