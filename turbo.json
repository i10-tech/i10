{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",

  // RUNTIME variables, deliberately passThrough rather than listed in a task's
  // `env`.
  //
  // Anything in `env` becomes part of the cache key, and the whole point of
  // these is that they do NOT affect the build: a promotion re-tags the staging
  // image byte-for-byte, so one artifact has to serve both environments and
  // learn which one it is at runtime. Listing them as build inputs would make
  // staging and production produce different images, which is exactly what the
  // promotion model exists to avoid.
  //
  // They are listed at all - rather than left out - because
  // `turbo/no-undeclared-env-vars` is an error here, and that rule is a
  // correctness guard, not style: reading an undeclared variable produces a
  // build cached against the wrong key and silently reused with stale values.
  // ⚠ IT IS AN ALLOWLIST, AND IT WAS MISSING 47 OF THE 62 VARIABLES THE CODE
  // READS - WHICH MEANT `bun run dev` COULD NOT START THE API AT ALL. Turbo
  // strips anything not named here before it spawns a task, so `doppler run --
  // bun run dev` injected a complete environment and the API still died with
  // "Invalid environment: REDIS_URL … MAIL_DOMAINS … SES_CONFIGURATION_SET".
  // The variables were present in the parent process and filtered out one layer
  // down, which is the least visible place for them to go missing: `printenv`
  // shows them, the app does not see them.
  //
  // ⚠ SO IT IS DERIVED, NOT CURATED. Every key the API's zod schema declares,
  // plus every `process.env.X` our own source reads, plus the three the AWS SDK
  // reads on its own behalf. Keeping it by hand is what let it drift this far.
  "globalPassThroughEnv": [
    "PORT",
    "HOSTNAME",
    "GIT_SHA",
    "API_BASE_URL",
    "API_KEY_CACHE_TTL_SECONDS",
    "AUTH_ALLOWED_REDIRECT_ORIGINS",
    "AUTH_DEFAULT_REDIRECT_URL",
    "AUTH_EMAIL_FROM",
    "AUTH_EMAIL_TENANT_SLUG",
    "AUTH_ORIGINS",
    "AWS_ACCESS_KEY_ID",
    "AWS_REGION",
    "AWS_SECRET_ACCESS_KEY",
    "AWS_SESSION_TOKEN",
    "CLERK_PUBLISHABLE_KEY",
    "CLERK_SECRET_KEY",
    "CLERK_SIGN_IN_URL",
    "CLERK_SIGN_UP_URL",
    "CLERK_WEBHOOK_SECRET",
    "CONSOLE_ORIGINS",
    "CONSOLE_PREVIEW",
    "DATABASE_URL",
    "I10_API_KEY",
    "I10_BASE_URL",
    "MAIL_DOMAINS",
    "MAIL_HOSTNAME",
    "MAIL_NAMESERVERS",
    "MAIL_SPF_INCLUDE",
    "NEXT_DIST_DIR",
    "METERING_EVENT_NAME",
    "METERING_FEATURE_ID",
    "METERING_FREE_PLAN_ID",
    "METRICS_TOKEN",
    "MIGRATE_DATABASE_URL",
    "POLAR_ACCESS_TOKEN",
    "POLAR_PRODUCTS",
    "POLAR_SERVER",
    "POLAR_SUCCESS_URL",
    "POLAR_TIMEOUT_MS",
    "POLAR_WEBHOOK_SECRET",
    "RECONCILE_LOOKBACK_DAYS",
    "REDIS_URL",
    "SENTRY_DSN",
    "SENTRY_ENVIRONMENT",
    "SES_CONFIGURATION_SET",
    "SES_ENABLED",
    "SES_RELAY_ENABLED",
    "STALWART_API_TOKEN",
    "STALWART_RELAY_HOST",
    "STALWART_RELAY_PORT",
    "STALWART_URL",
    "STALWART_WEBHOOK_SECRET",
    "SWEEP_MAX_ROWS",
    "SWEEP_QUEUED_GRACE",
    "TEMPLATE_RENDERER_SECRET",
    "TEMPLATE_RENDERER_URL",
    "WEBHOOK_CONCURRENCY",
    "WEBHOOK_EGRESS_ALLOW",
    "WEBHOOK_SECRET_KEY",
    "WORKER_BATCH_CONCURRENCY",
    "WORKER_CLAIM_STALE_AFTER",
    "WORKER_CONCURRENCY",
    "WORKER_JOB_TIMEOUT_MS",
    "WORKER_MAX_ATTEMPTS",
    "CLIENT_CONTEXT_SECRET",
    "IPINFO_TOKEN",
    "LAYA_API_KEY",
    "LAYA_URL",
    "RISK_ACT_HOLDS",
    "METERING_TEST_API_DATABASE_URL",
    "METERING_TEST_DATABASE_URL",
    "RISK_ACT_SES_POLICY",
    "RISK_ACT_TAKEOVER",
    "RISK_ACT_TIERS",
    "RISK_EMBEDDER",
    "RISK_ENABLED",
    "RISK_FARM_TRIPWIRE",
    "RISK_MODEL_DIR",
    "RISK_TEST_API_DATABASE_URL",
    // ⚠ ADDED 2026-10-04, THE SAME DRIFT AGAIN: these were declared by the
    // API's schema but stripped here, so locally the Cloudflare "Connect"
    // button said "not configured" with the app sitting in Doppler, and R2
    // bodies, the GitHub app and template assets were silently off.
    //
    // ⚠ `DNS_OAUTH_*` IS A WILDCARD ON PURPOSE. Each provider brings its own
    // DNS_OAUTH_<SLUG>_CLIENT_ID / _CLIENT_SECRET / _SCOPES (see
    // apps/api/src/env.ts `collectOAuthApps`), so a list of names would go
    // stale the day a second provider is registered. It also covers
    // DNS_OAUTH_REDIRECT_BASE and the broker's URL and secret.
    "DNS_OAUTH_*",
    "AWS_ACCOUNT_ID",
    "CONTENT_BODY_CACHE_MB",
    "CONTENT_KEYS",
    "CONTENT_OBJECT_GRACE_HOURS",
    "CONTENT_PACK_MAX_WAIT_HOURS",
    "CONTENT_PACK_TARGET_BYTES",
    "CONTENT_STORE_ACCESS_KEY_ID",
    "CONTENT_STORE_BATCH",
    "CONTENT_STORE_BUCKET",
    "CONTENT_STORE_ENDPOINT",
    "CONTENT_STORE_SECRET_ACCESS_KEY",
    "CONTENT_TEMPLATE_STALE_DAYS",
    "DOMAIN_ORPHANS_REMOVE",
    "GITHUB_APP_CLIENT_ID",
    "GITHUB_APP_CLIENT_SECRET",
    "GITHUB_APP_ID",
    "GITHUB_APP_PRIVATE_KEY",
    "GITHUB_APP_SLUG",
    "GITHUB_APP_WEBHOOK_SECRET",
    "RETENTION_BATCH",
    "TEMPLATE_ASSETS_ACCESS_KEY_ID",
    "TEMPLATE_ASSETS_BUCKET",
    "TEMPLATE_ASSETS_ENDPOINT",
    "TEMPLATE_ASSETS_PUBLIC_URL",
    "TEMPLATE_ASSETS_SECRET_ACCESS_KEY",
    "WEBRISK_DAILY_LIMIT",
    "RISK_TEST_DATABASE_URL",
    "STORAGE_TEST_API_DATABASE_URL",
    "STORAGE_TEST_DATABASE_URL",
    "TEMPLATES_TEST_DATABASE_URL",
    "WEBHOOKS_LAB_SLOW",
    "WEBHOOKS_TEST_DATABASE_URL",
    "WEBHOOKS_TEST_REDIS_URL",
    "WEBHOOKS_TEST_RENDERER_URL",
    "WEBRISK_API_KEY"
  ],

  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      // Baked into the artifact and reported by /version, so they ARE build
      // inputs - unlike the passThrough list above.
      "env": ["GIT_SHA", "GIT_BRANCH", "BUILD_TIME", "NODE_ENV"]
    },
    "lint": { "dependsOn": ["^lint"] },
    // `^build` because a package's `exports` point at dist/, which does not
    // exist until its build has run. Without it a consumer fails with TS2307
    // on a package sitting right there in the workspace.
    "check-types": { "dependsOn": ["^build", "^check-types"] },
    "test": { "dependsOn": ["^build"], "outputs": [] },
    // Regenerating the published document reads @repo/contracts at RUNTIME, so
    // it needs the same `^build` as check-types - the package's exports point at
    // dist/. Without it the script dies with ERR_MODULE_NOT_FOUND on a clean
    // checkout, which looks like a broken dependency rather than a missing build.
    //
    // ⚠ `cache: false` BECAUSE THIS IS A DRIFT GUARD. Its whole job is to
    // regenerate the file and let `git diff --exit-code` judge the result. A
    // restored cache hit would skip the regeneration and pass unconditionally,
    // turning the check that protects the committed spec into a no-op.
    "openapi": { "dependsOn": ["^build"], "cache": false },
    "dev": { "cache": false, "persistent": true },
    // ⚠ @i10/next's DTS build RESOLVES `@i10/node` THROUGH ITS dist/ (it is
    // external, not bundled), and on a fresh checkout that folder does not exist
    // until the SDK has built. Both watchers used to start together, so next's
    // first DTS pass raced node's and lost with TS7016 - transient, but it left
    // next's types stale until the next save. A one-shot `build` first makes it
    // deterministic; `@i10/node#dev` cannot be the dependency, because a
    // persistent task never finishes. The watcher no longer cleans (see
    // packages/node/tsup.config.ts), so it cannot pull the .d.ts back out.
    "@i10/next#dev": {
      "dependsOn": ["@i10/node#build"],
      "cache": false,
      "persistent": true
    }
  }
}
