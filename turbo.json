{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",

  // RUNTIME variables, deliberately passThrough rather than listed in a task's
  // `env`.
  //
  // Anything in `env` becomes part of the cache key, and the whole point of
  // these is that they do NOT affect the build: a promotion re-tags the staging
  // image byte-for-byte, so one artifact has to serve both environments and
  // learn which one it is at runtime. Listing them as build inputs would make
  // staging and production produce different images, which is exactly what the
  // promotion model exists to avoid.
  //
  // They are listed at all — rather than left out — because
  // `turbo/no-undeclared-env-vars` is an error here, and that rule is a
  // correctness guard, not style: reading an undeclared variable produces a
  // build cached against the wrong key and silently reused with stale values.
  "globalPassThroughEnv": [
    // Read by drizzle.config.ts and src/migrate.ts at migrate time only. Passed
    // through rather than hashed: a connection string does not change what gets
    // built. MIGRATE_DATABASE_URL is the migration Job's override — it points at
    // the primary rather than the pooler, because DDL and advisory locks do not
    // survive transaction pooling.
    "DATABASE_URL",
    "MIGRATE_DATABASE_URL",
    // Read directly by scripts/adopt-dkim.ts, which unseals the stored DKIM
    // private key and talks to SES. Runtime only: they change nothing about
    // what gets built.
    "WEBHOOK_SECRET_KEY",
    "AWS_REGION",
    "I10_API_KEY",
    "I10_BASE_URL",
    // The pod name, read by the worker to build a claim identity. Runtime only
    // and per-replica by definition, so it could not be a build input even if
    // it wanted to be.
    "HOSTNAME",
    // The console's Clerk wiring. ⚠ UNPREFIXED ON PURPOSE, AND THAT IS WHY THEY
    // BELONG HERE RATHER THAN IN A TASK'S `env`. Next inlines `NEXT_PUBLIC_*`
    // at BUILD time — server code included — so a prefixed key absent from a CI
    // build is compiled in as `undefined` and cannot be set later in the pod.
    // Unprefixed, read at request time, they stay genuinely runtime, which is
    // what lets one image serve every environment. Read by BOTH apps/console
    // and apps/auth. CLERK_SIGN_IN_URL and CLERK_SIGN_UP_URL point the console
    // at apps/auth (auth.i10.tech); left unset, Clerk silently falls back to
    // its own hosted Account Portal, which is a page we do not control.
    // ⚠ A LOCAL-REVIEW SWITCH THAT CANNOT BE REACHED IN PRODUCTION. See
    // apps/console/lib/preview.ts: the flag is ANDed with
    // `process.env.NODE_ENV !== "production"`, which Next replaces with a
    // literal at build time — so in a production image the whole expression
    // folds to `false` and the fixture module is removed by the bundler.
    // Declared here because `turbo/no-undeclared-env-vars` is an error in this
    // repo, and passed through rather than hashed because it changes nothing
    // about what gets built.
    "CONSOLE_PREVIEW",
    // Where apps/console reaches apps/api. ⚠ UNPREFIXED FOR THE SAME REASON THE
    // CLERK KEYS ARE: Next inlines `NEXT_PUBLIC_*` at BUILD time, even in server
    // code, so a prefixed name absent from a CI build is compiled in as
    // `undefined` and cannot be set later in the pod. Read at request time by
    // apps/console/lib/api.ts.
    "API_BASE_URL",
    "CLERK_PUBLISHABLE_KEY",
    "CLERK_SECRET_KEY",
    "CLERK_SIGN_IN_URL",
    "CLERK_SIGN_UP_URL",
    // apps/auth. Where a completed sign-in lands, and the origins it is allowed
    // to land on. ⚠ THE ALLOWLIST IS A SECURITY CONTROL, NOT CONFIGURATION —
    // see apps/auth/app/_lib/redirect.ts. Empty means every `?redirect_url=` is
    // refused and everyone goes to the default, which fails closed.
    "AUTH_DEFAULT_REDIRECT_URL",
    "AUTH_ALLOWED_REDIRECT_ORIGINS",
    "SENTRY_ENVIRONMENT",
    "OTEL_EXPORTER_OTLP_ENDPOINT",
    "OTEL_SERVICE_NAME"
  ],

  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      // Baked into the artifact and reported by /version, so they ARE build
      // inputs — unlike the passThrough list above.
      "env": ["GIT_SHA", "GIT_BRANCH", "BUILD_TIME", "NODE_ENV"]
    },
    "lint": { "dependsOn": ["^lint"] },
    // `^build` because a package's `exports` point at dist/, which does not
    // exist until its build has run. Without it a consumer fails with TS2307
    // on a package sitting right there in the workspace.
    "check-types": { "dependsOn": ["^build", "^check-types"] },
    "test": { "dependsOn": ["^build"], "outputs": [] },
    // Regenerating the published document reads @repo/contracts at RUNTIME, so
    // it needs the same `^build` as check-types — the package's exports point at
    // dist/. Without it the script dies with ERR_MODULE_NOT_FOUND on a clean
    // checkout, which looks like a broken dependency rather than a missing build.
    //
    // ⚠ `cache: false` BECAUSE THIS IS A DRIFT GUARD. Its whole job is to
    // regenerate the file and let `git diff --exit-code` judge the result. A
    // restored cache hit would skip the regeneration and pass unconditionally,
    // turning the check that protects the committed spec into a no-op.
    "openapi": { "dependsOn": ["^build"], "cache": false },
    "dev": { "cache": false, "persistent": true }
  }
}
