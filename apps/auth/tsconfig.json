{
  "extends": "@repo/typescript-config/nextjs.json",
  "compilerOptions": {
    "paths": { "@/*": ["./*"] },
    // ⚠ `bun` IS HERE FOR test/, WHICH IMPORTS `bun:test`. Without it
    // `check-types` fails on the import rather than on anything real.
    "types": ["bun"]
  },
  "include": ["**/*.ts", "**/*.tsx", "next-env.d.ts", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
