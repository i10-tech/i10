{
  "name": "@i10/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun build src/index.ts src/worker.ts src/migrate.ts src/sweep.ts src/reconcile.ts --target=bun --outdir=dist --splitting --sourcemap=linked",
    "dev": "bun --watch src/index.ts",
    "start": "bun dist/index.js",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit",
    "test": "bun test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "openapi": "bun scripts/generate-openapi.ts",
    "adopt-dkim": "bun scripts/adopt-dkim.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.1123.0",
    "@clerk/backend": "^3.16.13",
    "@hono/zod-openapi": "^1.6.1",
    "@hono/zod-validator": "^0.9.0",
    "@repo/contracts": "workspace:*",
    "@repo/emails": "workspace:*",
    "@repo/metering": "workspace:*",
    "@sentry/node": "10.73.0",
    "drizzle-orm": "^0.45.2",
    "groupmq": "^1.1.0",
    "hono": "^4.13.5",
    "ioredis": "^6.0.0",
    "nodemailer": "^10.0.10",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/bun": "^1.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "typescript": "6.0.3"
  },
  "exports": {
    "./openapi.json": "./openapi.json"
  }
}
