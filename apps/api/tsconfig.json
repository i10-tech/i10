{
  "extends": "@repo/typescript-config/base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["bun"]
  },
  // ⚠ `scripts` IS IN HERE DELIBERATELY. It was not, and the omission is the
  // kind that hides: a script full of type errors passes `check-types` because
  // nothing ever looks at it, and the first person to learn otherwise is
  // whoever runs it against production.
  // `types/` holds ambient declarations (the `*.lua` text imports); it is
  // outside src/ because the root .gitignore drops apps/*/src/**/*.d.ts.
  "include": ["src/**/*.ts", "test/**/*.ts", "scripts/**/*.ts", "types/**/*.d.ts"],
  "exclude": ["node_modules", "dist"]
}
