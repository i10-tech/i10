{"@type": "upsert", "object": "SieveSystemScript", "matchOn": ["name"], "value": {"sesReferences": {"name": "ses-references", "description": "Keep the original Message-ID in References for mail relayed through SES", "isActive": true, "contents": "require [\"editheader\", \"variables\"];\n\n# SES replaces Message-ID but leaves References alone, so the original id\n# rides in References and a reply still threads with the Sent copy.\nif header :matches \"Message-ID\" \"*\" {\n  set \"mid\" \"${1}\";\n  if header :matches \"References\" \"*\" {\n    set \"refs\" \"${1}\";\n    deleteheader \"References\";\n    addheader :last \"References\" \"${refs} ${mid}\";\n  } else {\n    addheader :last \"References\" \"${mid}\";\n  }\n}"}}}
