{"@type": "upsert", "object": "SieveSystemScript", "matchOn": ["name"], "value": {"sesReferences": {"name": "ses-references", "description": "Keep the original Message-ID in References for mail relayed through SES", "isActive": true, "contents": "require [\"editheader\", \"variables\"];\n\n# SES replaces Message-ID but leaves References alone, so the original id\n# rides in References and a reply still threads with the Sent copy.\nif header :matches \"Message-ID\" \"*\" {\n  set \"mid\" \"${1}\";\n  if header :matches \"References\" \"*\" {\n    set \"refs\" \"${1}\";\n    deleteheader \"References\";\n    addheader :last \"References\" \"${refs} ${mid}\";\n  } else {\n    addheader :last \"References\" \"${mid}\";\n  }\n}"}}}
{"@type": "update", "object": "MtaStageData", "value": {"enableSpamFilter": {"match": {}, "else": "is_empty(authenticated_as) && local_port != 2525"}, "script": {"match": {"0": {"if": "!is_empty(authenticated_as) && sql_query('i10', 'SELECT core.mailbox_route($1)', [sender_domain]) == 'ses-relay'", "then": "'ses-references'"}}, "else": "false"}, "dkimSignDomain": {"match": {"0": {"if": "is_local_domain(sender_domain) && !is_empty(authenticated_as) && sql_query('i10', 'SELECT core.mailbox_route($1)', [sender_domain]) != 'ses-relay'", "then": "sender_domain"}}, "else": "false"}}}
{"@type": "upsert", "object": "MtaInboundThrottle", "matchOn": ["description"], "value": {"iprate": {"description": "Sender IP throttle", "enable": true, "key": {"remoteIp": true}, "match": {"match": {}, "else": "local_port != 2525"}, "rate": {"count": 5, "period": 1000}}}}
{"@type": "upsert", "object": "MtaInboundThrottle", "matchOn": ["description"], "value": {"rcptrate": {"description": "Sender address to recipient throttle", "enable": true, "key": {"senderDomain": true, "rcpt": true}, "match": {"match": {}, "else": "local_port != 2525"}, "rate": {"count": 25, "period": 3600000}}}}
