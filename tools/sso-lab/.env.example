# i10 SSO lab - copy to .env (cp .env.example .env) and fill the blanks.
#
# EVERY PASSWORD AND SECRET IN THIS FILE IS A THROWAWAY LAB CREDENTIAL. None of
# it protects anything: the lab binds to loopback, holds six fake people, and is
# reset with ./lab.sh reset. Do not reuse any of it anywhere real.

# ---- the people ----------------------------------------------------------
# The ONE domain every seed user's email is on. It must be a name you can put a
# TXT record on: prove it in the i10 console (Settings > Team > Access domains)
# before you try a sign-in. A .test name cannot be proved.
LAB_DOMAIN=sso-lab.i10.tech
# Every seed user (alice, bob, carol, dave, erin, frank) has this password in
# OpenLDAP, Keycloak (via federation) and authentik.
LAB_USER_PASSWORD=Lab-Passw0rd-2026

# ---- i10 (the side under test) --------------------------------------------
# Browser-facing auth app: SAML ACS/entity ids and the OIDC redirect URI live here.
AUTH_ORIGIN=https://auth.i10.localhost
# How a CONTAINER reaches the bun API on the host: plain http, no CA to trust.
# SCIM push and OIDC back-channel logout use this.
API_ORIGIN_FROM_CONTAINERS=http://host.docker.internal:3001
# How YOUR SHELL reaches the same API (apply.sh and the README curl checks).
API_ORIGIN_FROM_HOST=http://127.0.0.1:3001

# ---- created in the i10 console by the human; apply.sh pushes them ---------
# One i10 SSO connection per (IdP, protocol). Leave blank what you are not testing.
CONNECTION_ID_KEYCLOAK_OIDC=
CONNECTION_ID_KEYCLOAK_SAML=
CONNECTION_ID_AUTHENTIK_OIDC=
CONNECTION_ID_AUTHENTIK_SAML=
# Console > Directories > the SCIM directory. The id is the last path segment of
# its base URL; the token is shown once when minted.
DIRECTORY_ID=
SCIM_TOKEN=

# ---- OIDC clients (you paste these into the i10 connection) ----------------
KEYCLOAK_OIDC_CLIENT_ID=i10-lab-oidc
KEYCLOAK_OIDC_CLIENT_SECRET=lab-keycloak-oidc-secret-0001
AUTHENTIK_OIDC_CLIENT_ID=i10-lab-oidc
AUTHENTIK_OIDC_CLIENT_SECRET=lab-authentik-oidc-secret-0001

# ---- admin logins ----------------------------------------------------------
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=lab-admin-pass
AUTHENTIK_ADMIN_EMAIL=akadmin@lab.localhost
AUTHENTIK_ADMIN_PASSWORD=lab-admin-pass
# Doubles as authentik's API token for apply.sh.
AUTHENTIK_BOOTSTRAP_TOKEN=lab-authentik-api-token-0001
AUTHENTIK_SECRET_KEY=lab-authentik-secret-key-not-a-secret-0123456789abcdef
OPENLDAP_ADMIN_PASSWORD=lab-ldap-admin
# The read-only service account you give i10's LDAP pass-through.
LDAP_SERVICE_PASSWORD=lab-ldap-service
MINIO_ROOT_USER=labminio
MINIO_ROOT_PASSWORD=lab-minio-pass-123

# ---- host ports (all free on the dev Mac at the time of writing) ------------
# 389 and 636 are NOT a choice: i10 accepts LDAP on those two ports only.
KEYCLOAK_HTTP_PORT=8180
KEYCLOAK_HTTPS_PORT=8443
AUTHENTIK_HTTP_PORT=9100
AUTHENTIK_HTTPS_PORT=9443
MINIO_CONSOLE_PORT=9011
MINIO_HTTPS_PORT=9012
CATCHER_HTTPS_PORT=8090
