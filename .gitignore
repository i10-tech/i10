node_modules/

# Build output
.next/
# `dev:preview` builds here so it can run beside a live `next dev`, which holds
# a lock on `.next` — see apps/console/next.config.ts.
.next-preview/
out/
dist/
build/
.astro/
.turbo/

# Env
.env
.env.*
!.env.example

# Editors / OS
.DS_Store
.idea/
.vscode/
*.swp

# Logs
*.log
npm-debug.log*

# Test / coverage
coverage/
.nyc_output/

# Local kubeconfig or credentials must never land here.
kubeconfig
*.kubeconfig
*.pem
*.key
!infra/**/*.example.key

# Next generates this on every build and rewrites it; committing it produces a
# diff on every developer's first `next dev`.
next-env.d.ts

# ⚠ A BARE `tsc` IN A PACKAGE WITH NO outDir SCATTERS .js AND .d.ts THROUGH
# src/. Every emitting tsconfig here pins outDir for exactly that reason, and
# apps/api/tsconfig.json sets noEmit so the type-check config cannot emit at
# all — but a stray run against the wrong config still happens, and the
# artifacts then get linted as if they were sources.
apps/*/src/**/*.js
apps/*/src/**/*.d.ts
apps/*/src/**/*.js.map
apps/*/src/**/*.d.ts.map

# Added by ggshield
.cache_ggshield

# ⚠ CADDY'S LOCAL ROOT, EXPORTED BY `bun run dev:trust`. It is per-machine —
# regenerated whenever the `caddy-data` volume is — so a committed copy would be
# a certificate everybody is told to trust and nobody's Caddy actually signs
# with. It is not secret (the private key never leaves the container), it is
# simply meaningless anywhere but the laptop that produced it.
dev/.caddy-root.crt
