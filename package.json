{
  "name": "i10",
  "private": true,
  "description": "i10 \u2014 transactional and human email.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,mjs,md,json,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,mjs,md,json,yaml,yml}\"",
    "version:next": "bun .github/scripts/next-version.mjs",
    "check-images": "bun .github/scripts/check-dockerfile-workspaces.mjs",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/bun": "^1.4.2",
    "prettier": "^3.9.6",
    "turbo": "^2.10.12",
    "typescript": "6.0.3",
    "prettier-plugin-astro": "^0.14.1"
  },
  "packageManager": "bun@1.4.2",
  "trustedDependencies": [
    "esbuild",
    "vue-demi"
  ],
  "overrides": {
    "@react-email/ui": {
      "next": "^16.3.3"
    }
  }
}
